local config = require('scripts.config.game_config')
local render = require('scripts.render.game_render')
local data = require('scripts.data.game_data')
local board_config = require('scripts.config.board_config')
local board_builder = require('scripts.game.board_builder')
local path_generator = require('scripts.game.plinko_path')
local math_utils = require('scripts.helpers.math_utils')

local function next_seed(self)
    self.path_seed = (self.path_seed or 0) + 1
    return self.path_seed
end

local function select_bucket_index(self)
    if self.bucket_rng == nil then
        self.bucket_rng = path_generator.create_rng(os.time() + next_seed(self) * 131)
    end

    return path_generator.select_bucket_index(
        self.board_state.baskets,
        config.baskets,
        self.bucket_rng
    )
end

local function create_board_state(viewport)
    return {
        spawn = board_builder.build_spawn_position(board_config, viewport),
        pegs = board_builder.build_peg_grid(board_config, viewport),
        baskets = board_builder.build_basket_nodes(board_config, config.baskets, viewport),
    }
end

local function spawn_ball(self)
    local target_bucket_index = math_utils.clamp(select_bucket_index(self), 1, #config.baskets)
    local seed = next_seed(self)
    local path = path_generator.generate(self.board_state, target_bucket_index, seed)
    local ball_id = factory.create('/drop_hole#ball_factory', self.board_state.spawn)
    self.active_balls[ball_id] = {
        path = path,
        bucket_index = target_bucket_index,
    }
    msg.post(ball_id, 'start_simulation', {
        owner = msg.url("#"),
        path = path,
    })
end

local function spawn_balls(self)
    if self.scene == nil or self.board_state == nil then
        return
    end

    local count = math_utils.clamp(data.get_playable_balls_count(), 0, data.get_balls_count())
    msg.post(".", "remove_balls", { amount = count })
    
    for i = 1, count do
        spawn_ball(self)    
    end
end

local function get_viewport()
    local width, height = render.default_viewport_size()
    return { width = width, height = height }
end

local function build_scene_state(viewport)
    return {
        ready = true,
        viewport = viewport,
    }
end

local function build_board(self, viewport)
    self.board_state = create_board_state(viewport)

    local pegs = board_builder.build_peg_positions(board_config, viewport)
    for _, position in ipairs(pegs) do
        factory.create('/board#peg_factory', position, nil, {}, board_builder.peg_scale(board_config))
    end

    local baskets = board_builder.build_basket_positions(board_config, config.baskets, viewport)
    local basket_scale = board_builder.basket_scale(board_config, #config.baskets, viewport)
    for _, info in ipairs(baskets) do
        local basket_go = factory.create('/board#basket_factory', info.position, nil, {}, basket_scale)
        msg.post(basket_go, "setup", { config = info.config })
    end
end

local function emit_ready(self)
    local viewport = get_viewport()

    if not self.board_built then
        build_board(self, viewport)
        self.board_built = true
    end

    self.scene = build_scene_state(viewport)
    msg.post(".", "ready", { scene = self.scene })
end

function init(self)
    self.active_balls = {}
    self.path_seed = 0
    emit_ready(self)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("spawn_ball") then
        spawn_balls(self)
    elseif message_id == hash("ball_landed") then
        local ball = self.active_balls[message.ball_id]
        local bucket_index = message.bucket_index or (ball and ball.bucket_index)
        local bucket_config = config.baskets[bucket_index]
        self.active_balls[message.ball_id] = nil
        msg.post(".", "add_score", { amount = bucket_config.score })
        msg.post(".", "track_hit", { bucket_index = bucket_index })
    end
end
