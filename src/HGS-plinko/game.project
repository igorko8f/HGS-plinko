[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 560
height = 780
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = HGS-plinko

[input]
use_accelerometer = 0
game_binding = /input/game.input_bindingc
gamepad_database = /builtins/input/gamecontrollerdb.txt
gamepads = /builtins/input/default.gamepadsc

